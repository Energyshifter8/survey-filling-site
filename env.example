# Survey модулийн жинхэнэ backend (survey-staging.mindxplus.com БИШ — тэр нь
# амьд frontend, API биш гэдэг нь staging дээр шууд шалгагдсан):
NEXT_PUBLIC_API_URL=https://service-staging.mindxplus.com

# Fallback нэр (survey-client.js хоёуланг нь дэмждэг, гэхдээ давхардуулахгүй
# байхын тулд зөвхөн дээрхийг л тохируулахыг зөвлөж байна):
# NEXT_PUBLIC_SURVEY_API_BASE=https://service-staging.mindxplus.com

# Талент үнэлгээний (/talent/[token]) backend. Survey-ээс тусдаа байж болно —
# одоогоор dev backend (шинэ `answers`/`optionIds` submit гэрээ) руу заана.
# collector-staging.mindxplus.com нь хуучин `answerList` гэрээтэй тул ТОХИРОХГҮЙ
# (src/lib/api/recruitment-types.ts-ийн толгойг үз). Хоосон бол
# NEXT_PUBLIC_API_URL-ийг ашиглана.
NEXT_PUBLIC_RECRUITMENT_API_BASE=http://192.168.2.15:30110
